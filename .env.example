NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Engine: plain Postgres. Supabase transaction pooler (port 6543) for the app, direct for jobs.
# Local: postgres://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=
DATABASE_POOL_MAX=3

# Raw archive (Cloudflare R2, S3 API)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Weather warnings: official MeteoAlarm warnings through the MeteoGate gateway.
# A key is recommended for a dedicated service quota; anonymous access may be shared/rate limited.
METEOGATE_API_KEY=

# Contact included in the User-Agent for admin-triggered OpenStreetMap Nominatim geocoding.
WEATHER_GEOCODER_CONTACT=

# Optional single-host HTTPS raster tile provider. URL must include {z}, {x}, and {y}.
# Defaults to the public OpenStreetMap tile service; use a provider with an SLA for production scale.
NEXT_PUBLIC_WEATHER_TILE_URL=
NEXT_PUBLIC_WEATHER_TILE_ATTRIBUTION=
NEXT_PUBLIC_WEATHER_TILE_ATTRIBUTION_URL=

# Optional email delivery for orange/red warnings. Also set engine setting alerts.email_from.
RESEND_API_KEY=
