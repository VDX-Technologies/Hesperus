NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Engine: plain Postgres. Supabase transaction pooler (port 6543) for the app, direct for jobs.
# Local: postgres://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=
DATABASE_POOL_MAX=3

# Raw archive (Cloudflare R2, S3 API)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional email delivery for platform notifications.
RESEND_API_KEY=

# Web push alarm notifications (PWA). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@vdxtechnologies.com
