NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Engine: plain Postgres. Supabase transaction pooler (port 6543) for the app, direct for jobs.
# Local: postgres://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=
DATABASE_POOL_MAX=3

# Raw archive (Cloudflare R2, S3 API)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional email delivery for platform notifications.
RESEND_API_KEY=

# Web push alarm notifications (PWA). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@vdxtechnologies.com

# Bearer token for GET /api/cron/engine (hourly maintenance called by an external scheduler).
CRON_SECRET=
# Optional bearer token: /api/health adds run age and problem count when it is given.
HEALTH_TOKEN=
# Role the engine switches to for tenant queries (RLS). "off" disables it (tests only).
DATABASE_TENANT_ROLE=vdx_engine
# Root secret for signing Research project webhooks (X-VDX-Signature).
RESEARCH_WEBHOOK_SECRET=
# Ed25519 public key that OTA firmware must be signed with. Generate with scripts/sign-firmware.ts.
FIRMWARE_PUBLIC_KEY=
